GMAIL_USER=comskills.official@gmail.com
GMAIL_APP_PASSWORD=     # 16-character App Password (needs 2-Step Verification on that account)
MAIL_FROM_NAME=Comskills Circle
APP_TIME_ZONE=Asia/Karachi
CRON_SECRET=            # random string; Vercel sends it as a Bearer token to /api/cron/*
LLM_PROVIDER=gemini
