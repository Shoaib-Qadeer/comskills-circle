NEXTAUTH_SECRET=        # 40+ random characters
NEXTAUTH_URL=           # e.g. https://comskills-circle.vercel.app (no trailing slash)
GOOGLE_CLIENT_ID=       # Google Cloud → OAuth client (Web application) → Client ID
GOOGLE_CLIENT_SECRET=   # same OAuth client → Client secret
PASSWORD_LOGIN=         # leave empty for Google-only sign-in; "on" also allows email + password
