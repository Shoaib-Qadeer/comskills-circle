# --- Database (MongoDB Atlas free M0 cluster) ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=compass

# --- Auth (NextAuth + Google) ---
# Generate a secret with: openssl rand -base64 32  (or any long random string)
NEXTAUTH_SECRET=
# Your deployed URL, e.g. https://compass-aire.vercel.app (no trailing slash)
NEXTAUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAIN=learningplanetinstitute.org
ADMIN_EMAILS=shoaib.qadeer@learningplanetinstitute.org

# --- LLM (use a PAID tier with a budget alert; see README) ---
# One of: gemini | openai | anthropic | openrouter
LLM_PROVIDER=gemini
LLM_API_KEY=
# The provider's cheapest fast model ID, e.g. a "flash-lite" / "mini" / "haiku" class model
LLM_MODEL=
# App-level safety cap on LLM calls per day (falls back to rule-based matching after this)
LLM_DAILY_CALL_LIMIT=150
